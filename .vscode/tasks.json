{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build consoleApp",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Wall", "-Wextra",
                "-I${workspaceFolder}",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/source/terminal.cpp",
                "${workspaceFolder}/source/canvas.cpp",
                "${workspaceFolder}/source/renderer.cpp",
                "${workspaceFolder}/source/ansi.cpp",
                "-o",
                "${workspaceFolder}/main"
            ],
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build consoleApp (Windows)",
            "type": "cppbuild",
            "command": "cl.exe",
            "args": [
                "/Zi", "/EHsc", "/nologo",
                "/std:c++17",
                "/utf-8",
                "/W4",
                "/I${workspaceFolder}",
                "/Fe${workspaceFolder}\\main.exe",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\source\\terminal.cpp",
                "${workspaceFolder}\\source\\canvas.cpp",
                "${workspaceFolder}\\source\\renderer.cpp",
                "${workspaceFolder}\\source\\ansi.cpp"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"],
            "group": "build"
        }
    ]
}